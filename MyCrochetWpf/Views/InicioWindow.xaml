<Window x:Class="MyCrochetWpf.Views.InicioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyCrochet-Inicio"
        Width="1400"
        Height="1040"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource FondoCrema}"
        FontFamily="{StaticResource FuenteComfortaa}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <!-- Botón del menú lateral: la imagen de fondo define el aspecto. -->
        <Style x:Key="BotonMenu" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.8" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Iconos de la barra superior (minimizar / cerrar). -->
        <Style x:Key="BotonIcono" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.75" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botón sólido tinto ("Cerrar Sesión"). -->
        <Style x:Key="BotonTinto" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource TintoAcento}" />
            <Setter Property="Foreground" Value="{StaticResource FondoCrema}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.8" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Encabezado de la tabla de pendientes (tinto con texto blanco). -->
        <Style x:Key="EncabezadoPedidos" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource TintoAcento}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="{StaticResource FuenteComfortaa}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Celda sin borde; selección rosa con texto tinto. -->
        <Style x:Key="CeldaPedidos" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Foreground" Value="{StaticResource TintoAcento}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource RosaDetalle}" />
                    <Setter Property="Foreground" Value="{StaticResource TintoAcento}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Calendario: mismo tinto corporativo en texto y borde. -->
        <Style x:Key="DiaCalendario" TargetType="CalendarDayButton">
            <Setter Property="FontFamily" Value="{StaticResource FuenteComfortaa}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TintoAcento}" />
        </Style>

        <Style x:Key="MesCalendario" TargetType="CalendarButton">
            <Setter Property="FontFamily" Value="{StaticResource FuenteComfortaa}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TintoAcento}" />
        </Style>

    </Window.Resources>

    <!-- El layout replica el ClientSize 1571x1167 del WinForms; el Viewbox lo
         ajusta proporcionalmente al tamaño real de la ventana. -->
    <Viewbox Stretch="Uniform">
        <Canvas Width="1571" Height="1167" Background="{StaticResource FondoCrema}">

            <!-- panel4: área principal (fondo blanco hueso). -->
            <Border Canvas.Left="406"
                    Canvas.Top="68"
                    Width="1149"
                    Height="1077"
                    Background="{StaticResource FondoCrema}" />

            <!-- panel2: menú lateral. -->
            <Border Canvas.Left="-1"
                    Canvas.Top="42"
                    Width="384"
                    Height="1130"
                    Background="{StaticResource RosaDetalle}" />

            <!-- panel3: tarjeta del logo. -->
            <Image Canvas.Left="29"
                   Canvas.Top="47"
                   Width="330"
                   Height="252"
                   Source="pack://application:,,,/MyCrochetWpf;component/Assets/my.png"
                   Stretch="Fill" />

            <Image Canvas.Left="55"
                   Canvas.Top="69"
                   Width="280"
                   Height="205"
                   Source="pack://application:,,,/MyCrochetWpf;component/Assets/1000080172.png"
                   Stretch="Uniform" />

            <!-- Línea divisoria de la tarjeta (label1 del WinForms). -->
            <Rectangle Canvas.Left="33"
                       Canvas.Top="292"
                       Width="229"
                       Height="2"
                       Fill="{StaticResource TintoAcento}" />

            <!-- Botones del menú lateral. -->
            <Button Canvas.Left="78" Canvas.Top="342"
                    Width="281" Height="68"
                    Style="{StaticResource BotonMenu}">
                <Grid>
                    <Image Source="pack://application:,,,/MyCrochetWpf;component/Assets/log2.png" Stretch="Fill" />
                    <TextBlock Text="Inicio"
                               FontSize="17"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Button>

            <!-- btnPedidos: navega a Pedidos (C3-3). -->
            <Button Canvas.Left="78" Canvas.Top="437"
                    Width="281" Height="68"
                    Style="{StaticResource BotonMenu}"
                    Command="{Binding IrAPedidosCommand}">
                <Grid>
                    <Image Source="pack://application:,,,/MyCrochetWpf;component/Assets/Inicio/boton_menu.png" Stretch="Fill" />
                    <TextBlock Text="Pedidos"
                               FontSize="17"
                               Foreground="{StaticResource TintoAcento}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Button>

            <!-- TODO(C7): navegar a Inventario. -->
            <Button Canvas.Left="78" Canvas.Top="532"
                    Width="281" Height="68"
                    Style="{StaticResource BotonMenu}">
                <Grid>
                    <Image Source="pack://application:,,,/MyCrochetWpf;component/Assets/Inicio/boton_menu.png" Stretch="Fill" />
                    <TextBlock Text="Inventario"
                               FontSize="17"
                               Foreground="{StaticResource TintoAcento}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Button>

            <!-- TODO(C10): navegar a Cotización. -->
            <Button Canvas.Left="78" Canvas.Top="632"
                    Width="281" Height="68"
                    Style="{StaticResource BotonMenu}">
                <Grid>
                    <Image Source="pack://application:,,,/MyCrochetWpf;component/Assets/Inicio/boton_menu.png" Stretch="Fill" />
                    <TextBlock Text="Cotización"
                               FontSize="17"
                               Foreground="{StaticResource TintoAcento}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Button>

            <!-- TODO(C13): navegar a Configuración. -->
            <Button Canvas.Left="78" Canvas.Top="727"
                    Width="281" Height="68"
                    Style="{StaticResource BotonMenu}">
                <Grid>
                    <Image Source="pack://application:,,,/MyCrochetWpf;component/Assets/Inicio/boton_menu.png" Stretch="Fill" />
                    <TextBlock Text="Configuración"
                               FontSize="17"
                               Foreground="{StaticResource TintoAcento}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Button>

            <!-- Iconos del menú (pictureBox1..5). -->
            <Image Canvas.Left="15" Canvas.Top="354" Width="54" Height="57"
                   Source="pack://application:,,,/MyCrochetWpf;component/Assets/imginic.png" Stretch="Fill" />
            <Image Canvas.Left="15" Canvas.Top="449" Width="54" Height="57"
                   Source="pack://application:,,,/MyCrochetWpf;component/Assets/imgped.png" Stretch="Fill" />
            <Image Canvas.Left="15" Canvas.Top="544" Width="54" Height="57"
                   Source="pack://application:,,,/MyCrochetWpf;component/Assets/imginv.png" Stretch="Fill" />
            <Image Canvas.Left="15" Canvas.Top="644" Width="54" Height="57"
                   Source="pack://application:,,,/MyCrochetWpf;component/Assets/imgcoti.png" Stretch="Fill" />
            <Image Canvas.Left="15" Canvas.Top="739" Width="54" Height="57"
                   Source="pack://application:,,,/MyCrochetWpf;component/Assets/imgconfig.png" Stretch="Fill" />

            <!-- Cerrar sesión (button5 del WinForms). -->
            <Button Canvas.Left="78" Canvas.Top="1099"
                    Width="250" Height="47"
                    Style="{StaticResource BotonTinto}"
                    Content="Cerrar Sesión"
                    Click="CerrarSesion_Click" />

            <!-- Saludo. -->
            <TextBlock Canvas.Left="482"
                       Canvas.Top="153"
                       Text="{Binding Saludo}"
                       FontSize="64"
                       Foreground="{StaticResource TintoAcento}" />

            <!-- Línea divisoria del saludo (label3 del WinForms). -->
            <Rectangle Canvas.Left="482"
                       Canvas.Top="266"
                       Width="707"
                       Height="2"
                       Fill="{StaticResource TintoAcento}" />

            <!-- Pedidos / Pendientes. -->
            <TextBlock Canvas.Left="559"
                       Canvas.Top="316"
                       Text="Pedidos"
                       FontSize="24"
                       Foreground="{StaticResource TintoAcento}" />

            <TextBlock Canvas.Left="610"
                       Canvas.Top="370"
                       Text="Pendientes"
                       FontSize="32"
                       Foreground="{StaticResource RosaDetalle}" />

            <Calendar Canvas.Left="557"
                      Canvas.Top="450"
                      Width="326"
                      Height="260"
                      Background="Transparent"
                      BorderBrush="{StaticResource RosaDetalle}"
                      BorderThickness="1"
                      Foreground="{StaticResource TintoAcento}"
                      FontFamily="{StaticResource FuenteComfortaa}"
                      CalendarDayButtonStyle="{StaticResource DiaCalendario}"
                      CalendarButtonStyle="{StaticResource MesCalendario}" />

            <DataGrid Canvas.Left="482"
                      Canvas.Top="720"
                      Width="506"
                      Height="310"
                      ItemsSource="{Binding Pedidos}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserSortColumns="False"
                      CanUserResizeColumns="False"
                      CanUserReorderColumns="False"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0"
                      RowHeight="30"
                      ColumnHeaderHeight="35"
                      ColumnHeaderStyle="{StaticResource EncabezadoPedidos}"
                      CellStyle="{StaticResource CeldaPedidos}"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource RosaDetalle}"
                      BorderThickness="0"
                      Background="{StaticResource FondoSuave}"
                      RowBackground="White"
                      AlternatingRowBackground="{StaticResource FondoAlterno}"
                      Foreground="{StaticResource TintoAcento}"
                      FontSize="13"
                      SelectionMode="Single"
                      SelectionUnit="FullRow">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Cliente"
                                        Binding="{Binding Cliente}"
                                        Width="1.1*" />
                    <DataGridTextColumn Header="Tipo de Pedido"
                                        Binding="{Binding TipoPedido}"
                                        Width="1.6*" />
                    <DataGridTextColumn Header="Fecha"
                                        Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}"
                                        Width="1*" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Alertas de inventario. -->
            <TextBlock Canvas.Left="1067"
                       Canvas.Top="316"
                       Text="Alertas de"
                       FontSize="24"
                       Foreground="{StaticResource TintoAcento}" />

            <TextBlock Canvas.Left="1155"
                       Canvas.Top="370"
                       Text="Inventario"
                       FontSize="32"
                       Foreground="{StaticResource RosaDetalle}" />

            <ScrollViewer Canvas.Left="1025"
                          Canvas.Top="450"
                          Width="469"
                          Height="580"
                          Background="{StaticResource FondoSuave}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <ItemsControl ItemsSource="{Binding Alertas}"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="440"
                                        MinHeight="55"
                                        Margin="5"
                                        Padding="10,4"
                                        Background="{StaticResource RosaDetalle}">
                                    <TextBlock FontFamily="{StaticResource FuenteComfortaa}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TintoAcento}"
                                               TextWrapping="Wrap">
                                        <Run Text="{Binding Marca, Mode=OneWay}" /><Run Text=" - " /><Run Text="{Binding Color, Mode=OneWay}" /><LineBreak />
                                        <Run Text="Tamaño: " /><Run Text="{Binding Tamaño, Mode=OneWay}" /><Run Text=" | Quedan: " /><Run Text="{Binding Inventario, Mode=OneWay}" />
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Equivale al label "No hay alertas" del WinForms. -->
                    <TextBlock Text="No hay alertas"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource FuenteComfortaa}"
                               FontSize="14"
                               FontStyle="Italic"
                               Foreground="Gray">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HayAlertas}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </ScrollViewer>

            <!-- btnNuevoPed: "Ver más pedidos" también abre Pedidos (C3-3). -->
            <Button Canvas.Left="610" Canvas.Top="1063"
                    Width="236" Height="45"
                    Style="{StaticResource BotonMenu}"
                    Command="{Binding IrAPedidosCommand}">
                <Grid>
                    <Image Source="pack://application:,,,/MyCrochetWpf;component/Assets/Inicio/boton_accion.png" Stretch="Fill" />
                    <TextBlock Text="Ver más pedidos"
                               FontSize="13"
                               Foreground="{StaticResource FondoCrema}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Button>

            <!-- TODO(C7): navegar a Inventario. -->
            <Button Canvas.Left="1155" Canvas.Top="1063"
                    Width="236" Height="45"
                    Style="{StaticResource BotonMenu}">
                <Grid>
                    <Image Source="pack://application:,,,/MyCrochetWpf;component/Assets/Inicio/boton_accion.png" Stretch="Fill" />
                    <TextBlock Text="Ver Inventario"
                               FontSize="13"
                               Foreground="{StaticResource FondoCrema}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Button>

            <!-- panel1: barra superior rosa (arrastrar / minimizar / cerrar). -->
            <Border Canvas.Left="-1"
                    Canvas.Top="0"
                    Width="1574"
                    Height="48"
                    Background="{StaticResource RosaDetalle}"
                    MouseLeftButtonDown="BarraTitulo_MouseLeftButtonDown">
                <Canvas>
                    <Button Style="{StaticResource BotonIcono}"
                            Canvas.Left="1470" Canvas.Top="5"
                            Width="40" Height="38"
                            Click="Minimizar_Click">
                        <Image Source="pack://application:,,,/MyCrochetWpf;component/Assets/3.png" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource BotonIcono}"
                            Canvas.Left="1519" Canvas.Top="5"
                            Width="37" Height="38"
                            Click="Cerrar_Click">
                        <Image Source="pack://application:,,,/MyCrochetWpf;component/Assets/2.png" Stretch="Uniform" />
                    </Button>
                </Canvas>
            </Border>

        </Canvas>
    </Viewbox>
</Window>
