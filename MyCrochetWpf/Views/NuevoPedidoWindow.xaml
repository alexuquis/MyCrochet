<Window x:Class="MyCrochetWpf.Views.NuevoPedidoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gif="clr-namespace:WpfAnimatedGif;assembly=WpfAnimatedGif"
        Title="MyCrochet-Nuevo Pedido"
        Width="597"
        Height="471"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource FondoSuave}"
        FontFamily="{StaticResource FuenteComfortaa}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <BooleanToVisibilityConverter x:Key="BoolAVisibilidad" />

        <!-- Botón sin cromo: la imagen del content define el fondo. -->
        <Style x:Key="BotonImagen" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.8" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botón "X" de la barra superior (btnCerrar del WinForms). -->
        <Style x:Key="BotonIcono" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.75" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Etiquetas del formulario (label2..label13, KG Red Hands 9.75 pt). -->
        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FuenteKGRedHands}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TintoAcento}" />
        </Style>

        <!-- Campos de una línea (los TextBox del WinForms iban sin borde; aquí se
             les da el borde rosa de la paleta para que se lean sobre el fondo). -->
        <Style x:Key="CampoPedido" TargetType="TextBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource TintoAcento}" />
            <Setter Property="CaretBrush" Value="{StaticResource TintoAcento}" />
            <Setter Property="BorderBrush" Value="{StaticResource RosaDetalle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="{StaticResource FuenteKGRedHands}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- txtNDesc: multilínea, el texto arranca arriba. -->
        <Style x:Key="CampoDescripcion"
               TargetType="TextBox"
               BasedOn="{StaticResource CampoPedido}">
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>

        <!-- Elementos del desplegable de los combos. -->
        <Style x:Key="ItemComboCampo" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource TintoAcento}" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="FontFamily" Value="{StaticResource FuenteKGRedHands}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="{StaticResource RosaDetalle}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource FondoAlterno}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Combos del formulario (cmbNTipo / cmbEstado / cmbNEnvio). -->
        <Style x:Key="ComboCampo" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource FondoCrema}" />
            <Setter Property="Foreground" Value="{StaticResource TintoAcento}" />
            <Setter Property="BorderBrush" Value="{StaticResource RosaDetalle}" />
            <Setter Property="FontFamily" Value="{StaticResource FuenteKGRedHands}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="24" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ItemComboCampo}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="BotonCombo"
                                          ClickMode="Press"
                                          Focusable="False"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1">
                                            <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Fill="{StaticResource TintoAcento}"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0" />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter Margin="6,0,20,0"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Slide">
                                <Border Background="White"
                                        BorderBrush="{StaticResource RosaDetalle}"
                                        BorderThickness="1"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource TintoAcento}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- datePed: el texto interno del DatePicker, sin cromo gris. -->
        <Style x:Key="CampoFecha" TargetType="DatePickerTextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TintoAcento}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CaretBrush" Value="{StaticResource TintoAcento}" />
            <Setter Property="FontFamily" Value="{StaticResource FuenteKGRedHands}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePickerTextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="4,0,0,0"
                                      VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Calendario del DatePicker: tinto corporativo (igual que Inicio). -->
        <Style x:Key="DiaCalendario" TargetType="CalendarDayButton">
            <Setter Property="FontFamily" Value="{StaticResource FuenteComfortaa}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TintoAcento}" />
        </Style>

        <Style x:Key="MesCalendario" TargetType="CalendarButton">
            <Setter Property="FontFamily" Value="{StaticResource FuenteComfortaa}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TintoAcento}" />
        </Style>

        <!-- Fecha de entrega: DatePicker plano con el calendario corporativo. -->
        <Style x:Key="SelectorFecha" TargetType="DatePicker">
            <Setter Property="Background" Value="{StaticResource FondoCrema}" />
            <Setter Property="Foreground" Value="{StaticResource TintoAcento}" />
            <Setter Property="BorderBrush" Value="{StaticResource RosaDetalle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="{StaticResource FuenteKGRedHands}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="SelectedDateFormat" Value="Short" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                </Grid.ColumnDefinitions>

                                <DatePickerTextBox x:Name="PART_TextBox"
                                                   Grid.Column="0"
                                                   Style="{StaticResource CampoFecha}" />

                                <Button x:Name="PART_Button"
                                        Grid.Column="1"
                                        Focusable="False"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent">
                                                <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="{StaticResource TintoAcento}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Popup x:Name="PART_Popup"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="2"
                                       AllowsTransparency="True"
                                       Placement="Bottom"
                                       PlacementTarget="{Binding ElementName=PART_TextBox}"
                                       StaysOpen="False"
                                       PopupAnimation="Slide">
                                    <Border Background="{StaticResource FondoCrema}"
                                            BorderBrush="{StaticResource RosaDetalle}"
                                            BorderThickness="1">
                                        <Calendar x:Name="PART_Calendar"
                                                  Background="{StaticResource FondoCrema}"
                                                  BorderThickness="0"
                                                  Foreground="{StaticResource TintoAcento}"
                                                  FontFamily="{StaticResource FuenteComfortaa}"
                                                  CalendarDayButtonStyle="{StaticResource DiaCalendario}"
                                                  CalendarButtonStyle="{StaticResource MesCalendario}" />
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource TintoAcento}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource TintoAcento}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- El layout replica el ClientSize 597x471 del WinForms. -->
    <Canvas Width="597" Height="471" Background="{StaticResource FondoSuave}">

        <!-- label3: línea rosa bajo la barra superior. -->
        <Rectangle Canvas.Left="-2"
                   Canvas.Top="33"
                   Width="598"
                   Height="4"
                   Fill="{StaticResource RosaDetalle}" />

        <!-- label6: título "Nuevo Pedido" (Super Mindset 30 pt). -->
        <TextBlock Canvas.Left="176"
                   Canvas.Top="56"
                   Text="Nuevo Pedido"
                   FontFamily="{StaticResource FuenteSuperMindset}"
                   FontSize="40"
                   Foreground="{StaticResource TintoAcento}" />

        <!-- label4 / label2 / label13. -->
        <TextBlock Canvas.Left="27" Canvas.Top="112"
                   Style="{StaticResource Etiqueta}"
                   Text="Nombre del Cliente:" />
        <TextBlock Canvas.Left="221" Canvas.Top="112"
                   Style="{StaticResource Etiqueta}"
                   Text="Num/Red social:" />
        <TextBlock Canvas.Left="416" Canvas.Top="112"
                   Style="{StaticResource Etiqueta}"
                   Text="Estado del Pedido:" />

        <!-- txtNNom / txtNContacto / cmbEstado. -->
        <TextBox Canvas.Left="27" Canvas.Top="134"
                 Width="161" Height="22"
                 Style="{StaticResource CampoPedido}"
                 Text="{Binding Cliente, UpdateSourceTrigger=PropertyChanged}" />

        <TextBox Canvas.Left="221" Canvas.Top="134"
                 Width="162" Height="22"
                 Style="{StaticResource CampoPedido}"
                 Text="{Binding Contacto, UpdateSourceTrigger=PropertyChanged}" />

        <ComboBox Canvas.Left="416" Canvas.Top="131"
                  Width="161"
                  Style="{StaticResource ComboCampo}"
                  ItemsSource="{Binding Estados}"
                  SelectedItem="{Binding EstadoSeleccionado}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Nombre}"
                               Foreground="{StaticResource TintoAcento}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- label5 / label7. -->
        <TextBlock Canvas.Left="27" Canvas.Top="160"
                   Style="{StaticResource Etiqueta}"
                   Text="Tipo de Pedido:" />
        <TextBlock Canvas.Left="221" Canvas.Top="160"
                   Style="{StaticResource Etiqueta}"
                   Text="Fecha de Entrega:" />

        <!-- cmbNTipo / datePed. -->
        <ComboBox Canvas.Left="27" Canvas.Top="182"
                  Width="161"
                  Style="{StaticResource ComboCampo}"
                  ItemsSource="{Binding Tipos}"
                  SelectedItem="{Binding TipoSeleccionado}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Nombre}"
                               Foreground="{StaticResource TintoAcento}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <DatePicker Canvas.Left="221" Canvas.Top="182"
                    Width="162" Height="23"
                    Style="{StaticResource SelectorFecha}"
                    SelectedDate="{Binding FechaEntrega}" />

        <!-- label8: Descripción. -->
        <TextBlock Canvas.Left="152" Canvas.Top="220"
                   Text="Descripción:"
                   FontFamily="{StaticResource FuenteKGRedHands}"
                   FontSize="16"
                   Foreground="{StaticResource TintoAcento}" />

        <!-- txtNDesc. -->
        <TextBox Canvas.Left="27" Canvas.Top="245"
                 Width="356" Height="92"
                 Style="{StaticResource CampoDescripcion}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}" />

        <!-- picBox1: GIF animado del tipo de pedido. -->
        <Image Canvas.Left="396" Canvas.Top="182"
               Width="181" Height="155"
               Stretch="Uniform"
               gif:ImageBehavior.AnimatedSource="{Binding GifActual}"
               Visibility="{Binding HayGif, Converter={StaticResource BoolAVisibilidad}}" />

        <!-- label11 / label9. -->
        <TextBlock Canvas.Left="27" Canvas.Top="353"
                   Style="{StaticResource Etiqueta}"
                   Text="Opción de envio:" />
        <TextBlock Canvas.Left="212" Canvas.Top="353"
                   Style="{StaticResource Etiqueta}"
                   Text="Subtotal:" />

        <!-- cmbNEnvio / txtSub. -->
        <ComboBox Canvas.Left="27" Canvas.Top="379"
                  Width="162"
                  Style="{StaticResource ComboCampo}"
                  ItemsSource="{Binding OpcionesEnvio}"
                  SelectedItem="{Binding EnvioSeleccionado}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Nombre}"
                               Foreground="{StaticResource TintoAcento}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBox Canvas.Left="212" Canvas.Top="379"
                 Width="161" Height="22"
                 Style="{StaticResource CampoPedido}"
                 Text="{Binding Subtotal, UpdateSourceTrigger=PropertyChanged}" />

        <!-- label12 / label10. -->
        <TextBlock Canvas.Left="27" Canvas.Top="409"
                   Style="{StaticResource Etiqueta}"
                   Text="Costo de envio:" />
        <TextBlock Canvas.Left="213" Canvas.Top="409"
                   Style="{StaticResource Etiqueta}"
                   Text="Anticipo:" />

        <!-- txtEnv / txtAnt. -->
        <TextBox Canvas.Left="27" Canvas.Top="431"
                 Width="162" Height="22"
                 Style="{StaticResource CampoPedido}"
                 Text="{Binding Envio, UpdateSourceTrigger=PropertyChanged}" />

        <TextBox Canvas.Left="212" Canvas.Top="431"
                 Width="161" Height="22"
                 Style="{StaticResource CampoPedido}"
                 Text="{Binding Anticipo, UpdateSourceTrigger=PropertyChanged}" />

        <!-- label1 / lblNTotal: total en vivo sobre fondo tinto. -->
        <TextBlock Canvas.Left="407" Canvas.Top="359"
                   Text="Total:"
                   FontFamily="{StaticResource FuenteGoodBakwan}"
                   FontSize="29"
                   Foreground="{StaticResource TintoAcento}" />

        <Border Canvas.Left="493" Canvas.Top="364"
                MinWidth="80"
                Padding="8,0"
                Background="{StaticResource TintoAcento}">
            <TextBlock Text="{Binding Total, StringFormat={}{0:0.00}}"
                       FontFamily="{StaticResource FuenteGoodBakwan}"
                       FontSize="24"
                       Foreground="{StaticResource FondoCrema}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>

        <!-- btnNPedido: "Registrar Pedido". -->
        <Button Canvas.Left="407" Canvas.Top="409"
                Width="159" Height="37"
                Style="{StaticResource BotonImagen}"
                Command="{Binding GuardarCommand}">
            <Grid>
                <Image Source="/Assets/Inicio/boton_accion.png" Stretch="Fill" />
                <TextBlock Text="Registrar Pedido"
                           FontFamily="{StaticResource FuenteKGRedHands}"
                           FontSize="15"
                           Foreground="{StaticResource TintoAcento}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>
        </Button>

        <!-- panel1: barra superior (arrastrar / cerrar). -->
        <Border Canvas.Left="0"
                Canvas.Top="0"
                Width="597"
                Height="33"
                Background="Transparent"
                MouseLeftButtonDown="BarraTitulo_MouseLeftButtonDown">
            <Button Style="{StaticResource BotonIcono}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Width="26" Height="22"
                    Margin="0,8,18,0"
                    Click="Cerrar_Click">
                <Image Source="/Assets/Login/icono_cerrar.png" Stretch="Uniform" />
            </Button>
        </Border>

    </Canvas>
</Window>
