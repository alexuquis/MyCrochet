<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta corporativa -->
    <SolidColorBrush x:Key="FondoCrema" Color="#FFF7F8" />
    <SolidColorBrush x:Key="RosaDetalle" Color="#FEA9BE" />
    <SolidColorBrush x:Key="TintoAcento" Color="#861940" />
    <!-- Fondos suaves de las tarjetas de Inicio (grid y panel de alertas). -->
    <SolidColorBrush x:Key="FondoSuave" Color="#FBE9E9" />
    <SolidColorBrush x:Key="FondoAlterno" Color="#FFF0F5" />

    <!-- Botón corporativo rosa con hover tinto.
         No fija tipografía: se hereda del Window o del contenedor. -->
    <Style x:Key="BotonRosa" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource RosaDetalle}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="22,10" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="18"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource TintoAcento}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="0.85" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
