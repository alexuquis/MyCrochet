<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Las fuentes se empaquetan como Resource; el URI apunta a su familia interna. -->
    <FontFamily x:Key="FuenteAdelia">pack://application:,,,/Fonts/#ADELIA</FontFamily>
    <FontFamily x:Key="FuenteComfortaa">pack://application:,,,/Fonts/#Comfortaa</FontFamily>
    <FontFamily x:Key="FuenteGoodBakwan">pack://application:,,,/Fonts/#Good Bakwan</FontFamily>
    <FontFamily x:Key="FuenteKGPerfect">pack://application:,,,/Fonts/#KG Perfect Penmanship</FontFamily>
    <FontFamily x:Key="FuenteKGRedHands">pack://application:,,,/Fonts/#KG Red Hands</FontFamily>
    <FontFamily x:Key="FuenteSuperMindset">pack://application:,,,/Fonts/#Super Mindset</FontFamily>

    <!-- Estilos de texto sin color: el color se define en cada vista con la paleta. -->
    <Style x:Key="TextoTitulo" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FuenteAdelia}" />
        <Setter Property="FontSize" Value="42" />
    </Style>

    <Style x:Key="TextoSubtitulo" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FuenteGoodBakwan}" />
        <Setter Property="FontSize" Value="24" />
    </Style>

    <Style x:Key="TextoCuerpo" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FuenteComfortaa}" />
        <Setter Property="FontSize" Value="16" />
    </Style>

</ResourceDictionary>
